{
  "name": "stay-tuned",
  "private": true,
  "version": "1.5.0",
  "description": "留频 — 播客与电台调谐器。订阅 RSS 播客，播放 M3U 电台，PC / 移动双端界面。",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --watch server/index.mjs\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "preview": "node server/index.mjs",
    "test": "node --test server/**/*.test.mjs",
    "license:check": "node scripts/check-licenses.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "notices": "node scripts/generate-notices.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "hls.js": "^1.7.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=20.19"
  },
  "license": "GPL-3.0-only",
  "author": "HarryLoong (https://github.com/xzl01)",
  "homepage": "https://github.com/xzl01/stay-tuned#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzl01/stay-tuned.git"
  },
  "bugs": {
    "url": "https://github.com/xzl01/stay-tuned/issues"
  },
  "keywords": [
    "podcast",
    "radio",
    "rss",
    "m3u",
    "hls",
    "pwa",
    "react",
    "typescript",
    "gplv3"
  ]
}
